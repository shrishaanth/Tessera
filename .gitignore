# Build output
# Any module's target/, not one named module: the build is multi-module now, and
# streaming-job/target holds a ~76 MB shaded jar.
target/
frontend/dist/

# Node
node_modules/
npm-debug.log*

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# Local env
*.local
.env
.env.*

# Logs
*.log

# Generated data. The Parquet archive is hundreds of megabytes and is rebuilt by
# running the generator; committing it would put a derived artefact in history
# that nothing can diff.
data/

# Spark local run artefacts. The checkpoint is streaming state, not source: it
# pins Kafka offsets and window state to one machine's run, so committing it
# would make another clone resume from offsets it never consumed.
spark-warehouse/
checkpoints/
*/checkpoints/
derby.log
metastore_db/

# Editor/agent scratch
.kilo/
.localredis/
