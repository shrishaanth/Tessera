<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.tessera.risk</groupId>
    <artifactId>tessera-risk</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>Tessera Risk</name>
    <description>Real-time fleet driver-behaviour risk analytics pipeline</description>

    <!-- Modules are added as each milestone lands, so the build stays green
         throughout rather than referencing directories that do not exist yet.
         Only the frontend re-theme remains. -->
    <modules>
        <module>common</module>
        <module>simulation</module>
        <module>event-producer</module>
        <module>archive-generator</module>
        <module>streaming-job</module>
        <module>batch-job</module>
        <module>ml-training</module>
        <module>reporting-api</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Java 17, not 21: Spark 3.5.x officially supports Java 8/11/17, and Java
             21 support arrived in Spark 4.0. Note that this is about which runtime
             Spark is tested against, not about the module system — Spark needs
             explicit JDK internals opened on 17 as well, which is why streaming-job
             passes a list of add-opens flags to its test JVM.

             The ceiling is harder than the floor: from Java 24 the Security Manager
             is gone, so Hadoop 3.3's Subject.getSubject throws and Spark cannot
             start at all. See the spark-needs-a-jdk-17-runtime profile below. -->
        <maven.compiler.release>17</maven.compiler.release>

        <spark.version>3.5.3</spark.version>
        <scala.binary.version>2.12</scala.binary.version>
        <kafka.version>3.7.1</kafka.version>
        <hbase.version>2.5.8</hbase.version>
        <!-- The Hadoop that Spark 3.5.3 itself ships. Pinned to that version rather
             than a newer one so the build never resolves a Hadoop the runtime does
             not actually have. -->
        <hadoop.version>3.3.4</hadoop.version>
        <jackson.version>2.15.2</jackson.version>
        <slf4j.version>2.0.13</slf4j.version>
        <junit.version>5.10.2</junit.version>
        <assertj.version>3.25.3</assertj.version>
        <spring.boot.version>3.3.5</spring.boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spark. Provided at run time by spark-submit; compile-scoped here so
                 the jobs can also be launched from a plain main() in local mode. -->
            <dependency>
                <groupId>org.apache.spark</groupId>
                <artifactId>spark-core_${scala.binary.version}</artifactId>
                <version>${spark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.spark</groupId>
                <artifactId>spark-sql_${scala.binary.version}</artifactId>
                <version>${spark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.spark</groupId>
                <artifactId>spark-mllib_${scala.binary.version}</artifactId>
                <version>${spark.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.spark</groupId>
                <artifactId>spark-sql-kafka-0-10_${scala.binary.version}</artifactId>
                <version>${spark.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.kafka</groupId>
                <artifactId>kafka-clients</artifactId>
                <version>${kafka.version}</version>
            </dependency>

            <dependency>
                <groupId>org.apache.hbase</groupId>
                <artifactId>hbase-client</artifactId>
                <version>${hbase.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            Spark 3.5 cannot run on a JDK newer than 23. Java 24 permanently removed
            the Security Manager, and Hadoop 3.3 still calls Subject.getSubject while
            starting up, which now throws UnsupportedOperationException. The symptom
            is that every test touching Spark dies at SparkSession creation.

            Compiling is unaffected, because maven.compiler.release pins the bytecode
            level whatever JDK is in use. Only the JVM that *runs* the tests matters.

            So on a too-new JDK, and only then, ask Maven for a real Java 17 and use
            it for compilation and for the forked test JVMs. A developer already on
            Java 17 needs none of this and the profile stays dormant, which is why it
            is a profile and not simply always on.

            Requires a jdk-17 entry in the user's ~/.m2/toolchains.xml. The build
            failing with "no matching toolchain" on Java 24+ is the correct outcome:
            the tests genuinely cannot run there, and failing is better than skipping
            them quietly.
        -->
        <profile>
            <id>spark-needs-a-jdk-17-runtime</id>
            <activation>
                <jdk>[24,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-toolchains-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <goals><goal>toolchain</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <toolchains>
                                <jdk>
                                    <version>17</version>
                                </jdk>
                            </toolchains>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <!-- Keep parameter names in the bytecode. Spring resolves
                             @PathVariable and @RequestParam names by reflection, and
                             without this every one would have to be spelled out a
                             second time as an annotation value. spring-boot-starter-parent
                             sets this for the same reason; this build has its own
                             parent, so it sets it here. -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <!-- Fat jars for the Spark jobs and the producer, so each service
                     image is a single self-contained artifact. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
