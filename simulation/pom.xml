<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tessera.risk</groupId>
        <artifactId>tessera-risk</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>simulation</artifactId>
    <name>Tessera Risk :: Simulation</name>
    <description>Vehicle physics, routing and behavioural event classification</description>

    <!--
        The motion engine, separated from anything that consumes it. It has two
        drivers: the live producer runs it at one tick per second to feed Kafka,
        and the archive generator runs it as fast as the CPU allows to build the
        training corpus.

        That sharing is the reason this is its own module rather than a package
        inside event-producer. A model trained on the archive is only valid against
        the live stream if both came from identical physics and identical event
        thresholds; keeping one copy of that code makes the claim structural instead
        of something that has to be remembered. It also keeps Kafka off the
        generator's classpath and Spark off the producer's.

        Deliberately free of any framework — no Kafka, no Spark, no files, no
        wall-clock timing. Everything is driven through tick(nowEpochMillis).
    -->
    <dependencies>
        <dependency>
            <groupId>com.tessera.risk</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>
</project>
