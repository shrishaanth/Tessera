<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.tessera.risk</groupId>
        <artifactId>tessera-risk</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>common</artifactId>
    <name>Tessera Risk :: Common</name>
    <description>Road network, geodesy and shared event model</description>

    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!--
            Provided, and only for TelemetrySchema. Three modules now write or read
            telemetry through Spark — the archive generator, the batch feature job and
            the streaming job — and all three must agree on its shape. One declaration
            here beats three that can drift apart, and a drifting schema does not fail
            loudly: it yields a column of nulls.

            Provided scope is what keeps this honest. It is not transitive, so nothing
            that merely depends on common — simulation, event-producer — acquires
            Spark. The dependency exists at compile time for one class and vanishes
            everywhere else.
        -->
        <dependency>
            <groupId>org.apache.spark</groupId>
            <artifactId>spark-sql_${scala.binary.version}</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
